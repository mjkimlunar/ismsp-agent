# 이 파일을 .env 로 복사하고 키를 채운다. .env 는 .gitignore 에 있으므로 저장소에 올라가지 않는다.
OPENAI_API_KEY=sk-...
ISMSP_MODEL=gpt-4o-mini

# ── 무료 모델로 바꿔 돌릴 때 ──────────────────────────────────
# Gemini (Google AI Studio 무료 한도 · https://aistudio.google.com/apikey 에서 발급)
#   ISMSP_PROVIDER=google
#   ISMSP_MODEL=gemini-2.0-flash
#   GOOGLE_API_KEY=...
#
# 로컬 Qwen (키 불필요 · ollama 설치 후 `ollama pull qwen2.5:3b`)
#   ISMSP_PROVIDER=ollama
#   ISMSP_MODEL=qwen2.5:3b
#   ISMSP_NUM_CTX=8192
